{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kkb-hub/hybrid-dev-orchestrator/schemas/hdo-config.schema.json",
  "title": "Hybrid Dev Orchestrator configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "activeProfile",
    "profiles",
    "runners",
    "github",
    "workflow",
    "paths",
    "projectContractPath"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "activeProfile": {
      "$ref": "#/$defs/name"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "runners": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/runner"
      }
    },
    "github": {
      "$ref": "#/$defs/github"
    },
    "workflow": {
      "$ref": "#/$defs/workflow"
    },
    "paths": {
      "$ref": "#/$defs/paths"
    },
    "projectContractPath": {
      "type": "string",
      "minLength": 1,
      "description": "Repository-root-relative path. Semantic validation must reject paths outside the repository."
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan",
            "implement",
            "review",
            "fix"
          ],
          "properties": {
            "plan": {
              "$ref": "#/$defs/step"
            },
            "implement": {
              "$ref": "#/$defs/requiredStep"
            },
            "review": {
              "$ref": "#/$defs/requiredStep"
            },
            "fix": {
              "$ref": "#/$defs/requiredStep"
            }
          }
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "runner": {
              "$ref": "#/$defs/name"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "required": [
                  "runner"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "runner"
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "requiredStep": {
      "oneOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "runner"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "runner": {
              "$ref": "#/$defs/name"
            }
          }
        }
      ]
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "provider",
        "command",
        "sandbox",
        "timeoutSeconds",
        "passEnvironment",
        "extraArgs"
      ],
      "properties": {
        "type": {
          "enum": [
            "codex",
            "claude",
            "command"
          ]
        },
        "provider": {
          "enum": [
            "cloud",
            "ollama",
            "lmstudio",
            "custom"
          ]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoningEffort": {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "contextTokens": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576,
          "description": "Requested model context window. The adapter records this requested value; provider-side observation is not available in MVP."
        },
        "sandbox": {
          "enum": [
            "read-only",
            "workspace-write"
          ]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "passEnvironment": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "promptTransport": {
          "enum": [
            "stdin",
            "file"
          ]
        },
        "allowedTools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "enum": [
                  "ollama",
                  "lmstudio"
                ]
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "required": [
              "model"
            ]
          }
        }
      ]
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels",
        "priorityOrder",
        "writeBack",
        "candidateLimit",
        "assignOnClaim"
      ],
      "properties": {
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ready",
            "skip",
            "statusPrefix",
            "claimed",
            "implementing",
            "review",
            "changesRequested",
            "approved",
            "escalated",
            "failed",
            "cancelled"
          ],
          "properties": {
            "ready": {
              "$ref": "#/$defs/label"
            },
            "skip": {
              "$ref": "#/$defs/label"
            },
            "statusPrefix": {
              "$ref": "#/$defs/label"
            },
            "claimed": {
              "$ref": "#/$defs/label"
            },
            "implementing": {
              "$ref": "#/$defs/label"
            },
            "review": {
              "$ref": "#/$defs/label"
            },
            "changesRequested": {
              "$ref": "#/$defs/label"
            },
            "approved": {
              "$ref": "#/$defs/label"
            },
            "escalated": {
              "$ref": "#/$defs/label"
            },
            "failed": {
              "$ref": "#/$defs/label"
            },
            "cancelled": {
              "$ref": "#/$defs/label"
            }
          }
        },
        "priorityOrder": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/label"
          }
        },
        "writeBack": {
          "enum": [
            "none",
            "status"
          ]
        },
        "candidateLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "assignOnClaim": {
          "type": "boolean"
        },
        "trustedActors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claimLeaseHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 720
        }
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxFixAttempts",
        "implicitFallback",
        "onNoDiff",
        "onValidationFailure",
        "onMaxFixAttempts"
      ],
      "properties": {
        "maxFixAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "Maximum number of fix executions after the initial implementation."
        },
        "implicitFallback": {
          "const": false,
          "description": "Provider/model fallback must always require an explicit configuration change."
        },
        "onNoDiff": {
          "enum": [
            "fail",
            "escalate"
          ]
        },
        "onValidationFailure": {
          "enum": [
            "request-changes",
            "escalate",
            "fail"
          ]
        },
        "onMaxFixAttempts": {
          "enum": [
            "escalate",
            "fail"
          ]
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worktreeRoot",
        "artifactRoot"
      ],
      "properties": {
        "worktreeRoot": {
          "type": "string",
          "minLength": 1
        },
        "artifactRoot": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
