{
  "$schema": "../../schemas/hdo-config.schema.json",
  "schemaVersion": 1,
  "activeProfile": "ollama-hybrid",
  "profiles": {
    "ollama-hybrid": {
      "steps": {
        "plan": "codex-cloud-planner",
        "implement": "claude-ollama-implementer",
        "review": "codex-cloud-reviewer",
        "fix": "claude-ollama-implementer"
      }
    }
  },
  "runners": {
    "codex-cloud-planner": {
      "type": "codex",
      "provider": "cloud",
      "command": "codex",
      "model": "gpt-5.6-sol",
      "reasoningEffort": "high",
      "sandbox": "read-only",
      "timeoutSeconds": 900,
      "passEnvironment": [],
      "extraArgs": []
    },
    "claude-ollama-implementer": {
      "type": "claude",
      "provider": "ollama",
      "command": "claude",
      "model": "qwen3.8:27b-q4_K_M",
      "contextTokens": 65536,
      "sandbox": "workspace-write",
      "timeoutSeconds": 1800,
      "passEnvironment": [],
      "extraArgs": []
    },
    "codex-cloud-reviewer": {
      "type": "codex",
      "provider": "cloud",
      "command": "codex",
      "model": "gpt-5.6-sol",
      "reasoningEffort": "high",
      "sandbox": "read-only",
      "timeoutSeconds": 1200,
      "passEnvironment": [],
      "extraArgs": []
    }
  },
  "github": {
    "labels": {
      "ready": "hdo:ready",
      "skip": "hdo:skip",
      "statusPrefix": "hdo:status/",
      "claimed": "hdo:status/claimed",
      "implementing": "hdo:status/implementing",
      "review": "hdo:status/review",
      "changesRequested": "hdo:status/changes-requested",
      "approved": "hdo:status/approved",
      "escalated": "hdo:status/blocked",
      "failed": "hdo:status/failed",
      "cancelled": "hdo:status/cancelled"
    },
    "priorityOrder": [
      "hdo:priority/p0",
      "hdo:priority/p1",
      "hdo:priority/p2",
      "hdo:priority/p3"
    ],
    "writeBack": "status",
    "candidateLimit": 50,
    "assignOnClaim": true
  },
  "workflow": {
    "maxFixAttempts": 2,
    "implicitFallback": false,
    "onNoDiff": "fail",
    "onValidationFailure": "request-changes",
    "onMaxFixAttempts": "escalate"
  },
  "paths": {
    "worktreeRoot": "%LOCALAPPDATA%/hdo/worktrees",
    "artifactRoot": "%LOCALAPPDATA%/hdo/runs"
  },
  "projectContractPath": ".hdo/project.json"
}
